# LLM 설정
OPENROUTER_API_KEY=your-api-key-here
LLM_MODEL_NAME=openai/gpt-4o-mini

# LangSmith (선택)
LANGSMITH_API_KEY=your-langsmith-key

# Checkpointer 설정 (선택, 기본값: .data/checkpoints.sqlite)
# CHECKPOINT_DB_PATH=.data/checkpoints.sqlite

# 인사이트 저장소 (임시 pgvector - 메인 서버 연동 시 제거)
INSIGHT_DB_URL=postgresql://user:pass@host:5432/dbname

# 인사이트 로그 검색 설정
INSIGHT_SEARCH_TOP_K=5
INSIGHT_SEARCH_THRESHOLD=0.7
