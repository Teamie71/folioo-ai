# LLM 설정
OPENROUTER_API_KEY=your-api-key-here
LLM_MODEL_NAME=openai/gpt-4o-mini
PDF_EXTRACTION_MODEL_NAME=google/gemini-3.1-pro-preview
FILE_PROCESSOR_MODEL_NAME=google/gemini-3.1-pro-preview

# LangSmith (선택)
LANGSMITH_API_KEY=your-langsmith-key

# PostgreSQL 설정 (경험 맵 DB — 메인 서버 소유, AI 서버는 읽기 전용)
# 로컬 세팅은 docs/architecture/experience-map-local-dev.md 참고
#   uv run --group local-db python scripts/experience_map/local_db.py init
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/folioo_expmap

# 경험 맵 DB 커넥션 풀 (선택)
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=3
# DB_STATEMENT_TIMEOUT_MS=5000

# 경험정리 티켓 서명 (프론트 → AI 직결 인증)
# AI_SERVICE_API_KEY 를 재사용하지 말 것. 두 키의 회전 주기가 다르고,
# API 키가 유출되면 티켓 위조까지 가능해진다.
# HS256 이므로 32바이트 이상 (예: openssl rand -base64 48)
EXPMAP_TICKET_SECRET=change-me-to-a-32-byte-or-longer-random-secret

# 경험정리 rate limit (선택) — 티켓 sub 단위 분당 요청 수. 기본값 20.
# worker 프로세스마다 따로 세므로 실질 한도는 worker 수만큼 배가 된다.
# 0·음수는 "전부 차단"이라 무시하고 기본값으로 되돌린다. 끌 때는 EXPERIENCE_MAP_ENABLED=false.
# EXPMAP_RATE_LIMIT_PER_MINUTE=20

# Checkpointer 설정 (필수 — DATABASE_URL fallback 없음)
# 경험 맵 DB와 반드시 분리한다. 같은 DB를 쓰면 LangGraph checkpoint 테이블이 경험 맵 DB에 생성된다.
CHECKPOINT_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/folioo_checkpoint

# 인사이트 로그 검색 설정
INSIGHT_SEARCH_TOP_K=5
INSIGHT_SEARCH_THRESHOLD=0.7

# 웹 검색 (Tavily)
TAVILY_API_KEY=your-tavily-api-key

# 메인 서버 (NestJS) 연동
MAIN_BACKEND_URL=https://api.folioo.api.kr
MAIN_BACKEND_API_KEY=your-main-backend-api-key
